---
import {
  profile,
  contact,
  experience,
  skills,
  education,
  certifications,
} from "../data/cv";
import { featuredProjects } from "../data/portfolio";
import "../styles/print-resume.css";

const linkedinSlug = contact.linkedin.replace(/^https?:\/\/(www\.)?linkedin\.com\/in\//, "");
const githubUrl = "github.com/rigohc";

const objective =
  "Desarrollador full stack con 6+ años en e-commerce, automatizaciones y microservicios. Busco aportar experiencia en React, Node.js, Magento, VTEX y arquitecturas orientadas a eventos a equipos que construyan productos escalables y confiables.";

const achievements = [
  "Plataforma Andromeda: automatizaciones, facturación y carga masiva con RabbitMQ.",
  "HEB / SISMEX: liderazgo técnico en microservicios, VTEX y Magento 2 enterprise.",
  "Ecosistema Magento 2: módulos custom, APIs REST/SOAP y despliegue Dockerizado.",
];

const additionalInfo = [
  { label: "Habilidades blandas", value: "Resolución de problemas, liderazgo técnico, trabajo en equipo, comunicación" },
  { label: "Idiomas", value: "Español (nativo), Inglés (técnico)" },
];
---

<article class="print-resume" aria-label="Currículum para imprimir">
  <header class="resume-header">
    <h1>{profile.name}</h1>
    <p class="resume-title">{profile.title} | Full Stack · E-commerce</p>
    <p class="resume-contact">
      {contact.location}
      <span class="sep">·</span>
      {contact.email}
      <span class="sep">·</span>
      {githubUrl}
      <span class="sep">·</span>
      linkedin.com/in/{linkedinSlug}
    </p>
  </header>

  <section class="resume-section">
    <h2>Objetivo</h2>
    <p>{objective}</p>
  </section>

  <section class="resume-section">
    <h2>Educación</h2>
    {education.map((item) => (
      <div class="resume-entry">
        <div class="resume-entry-head">
          <strong>{item.degree}</strong>
          <span>{item.period}</span>
        </div>
        <p class="resume-sub">{item.institution}</p>
      </div>
    ))}
  </section>

  <section class="resume-section">
    <h2>Habilidades técnicas</h2>
    <table class="resume-skills">
      <tbody>
        {skills.map((group) => (
          <tr>
            <th>{group.title}</th>
            <td>{group.items.join(", ")}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="resume-section">
    <h2>Experiencia profesional</h2>
    {experience.map((job) => (
      <div class="resume-entry">
        <div class="resume-entry-head">
          <strong>{job.role}</strong>
          <span>{job.period}</span>
        </div>
        <p class="resume-sub">{job.company}</p>
        {job.summary ? <p class="resume-summary">{job.summary}</p> : null}
        <ul>
          {job.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        {job.tech?.length ? (
          <p class="resume-tech">
            <em>Tecnologías:</em> {job.tech.join(" · ")}
          </p>
        ) : null}
      </div>
    ))}
  </section>

  <section class="resume-section">
    <h2>Proyectos destacados</h2>
    {featuredProjects.map((project) => (
      <div class="resume-entry">
        <div class="resume-entry-head">
          <strong>{project.name}</strong>
          <span>{project.tagline}</span>
        </div>
        <p class="resume-summary">{project.description}</p>
        <ul>
          <li>{project.impact}</li>
        </ul>
        <p class="resume-tech">
          <em>Stack:</em> {project.tech.join(" · ")}
        </p>
      </div>
    ))}
  </section>

  <section class="resume-section">
    <h2>Logros</h2>
    <ul class="resume-achievements">
      {achievements.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  {certifications.length > 0 ? (
    <section class="resume-section">
      <h2>Certificaciones</h2>
      {certifications.map((cert) => (
        <div class="resume-entry">
          <div class="resume-entry-head">
            <strong>{cert.name}</strong>
            <span>{cert.date}</span>
          </div>
          <p class="resume-sub">{cert.provider}</p>
        </div>
      ))}
    </section>
  ) : null}

  <section class="resume-section">
    <h2>Información adicional</h2>
    <table class="resume-skills">
      <tbody>
        {additionalInfo.map((row) => (
          <tr>
            <th>{row.label}</th>
            <td>{row.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</article>
